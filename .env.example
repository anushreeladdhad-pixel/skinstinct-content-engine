# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here
# Random string; Telegram sends it back in a header so we know the request is genuine (openssl rand -hex 16)
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here
# Optional but recommended: only accept notes from these chats, comma-separated
# (channel ids start with -100; a private chat id is the user's Telegram id)
TELEGRAM_CHAT_ID=

# Gemini — https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-flash-latest

# Drafting model: "gemini" (L3) or "claude" (B1 onwards)
DRAFT_MODEL=gemini
# Only needed if DRAFT_MODEL=claude or you use /compare — https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Supabase — Settings → API. Use the service_role secret, NOT the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Notes scoring below this are not drafted
SCORE_THRESHOLD=6
